# =============================================================================
# OpenWA - Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# This is the Single Source of Truth for all configuration.

# =============================================================================
# CORE SETTINGS
# =============================================================================
NODE_ENV=production
API_PORT=2785
LOG_LEVEL=info                      # error | warn | info | debug

# Domain Configuration
DOMAIN=localhost
DASHBOARD_PORT=2886

# Public URLs (for startup banner and external access)
# BASE_URL=https://api.yourdomain.com
# DASHBOARD_URL=https://dashboard.yourdomain.com

# CORS Configuration (comma-separated origins, or * for all)
CORS_ORIGINS=*

# SSL/TLS (enable for production with real domain)
# TRAEFIK_ACME_EMAIL=admin@yourdomain.com
# TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json

# =============================================================================
# COMPONENTS (enable/disable container profiles)
# =============================================================================
DASHBOARD_ENABLED=true              # Enable dashboard container
PROXY_ENABLED=true                  # Enable Traefik proxy container

# =============================================================================
# ENGINE CONFIGURATION
# =============================================================================
# Which WhatsApp engine to use (plugin-based)
# Options: whatsapp-web.js, baileys (future)
ENGINE_TYPE=whatsapp-web.js

# Engine-specific settings
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# Max inline media size in bytes. Larger incoming media keeps its metadata but
# drops the base64 payload (prevents memory spikes on large-media bursts).
MEDIA_MAX_BYTES=67108864            # 64 MiB

# =============================================================================
# DATABASE
# =============================================================================
# Options: sqlite, postgres
DATABASE_TYPE=sqlite
POSTGRES_BUILTIN=false              # Use built-in PostgreSQL container?

# PostgreSQL settings (ignored for sqlite, auto-configured if POSTGRES_BUILTIN=true)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=your-secure-password
DATABASE_SYNCHRONIZE=false          # WARNING: Set false in production!
DATABASE_LOGGING=false

# =============================================================================
# REDIS / QUEUE (Phase 2)
# =============================================================================
REDIS_ENABLED=false                 # Enable Redis for queue and caching
REDIS_BUILTIN=false                 # Use built-in Redis container?

# Redis settings (auto-configured if REDIS_BUILTIN=true)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# STORAGE
# =============================================================================
# Options: local, s3
STORAGE_TYPE=local
MINIO_BUILTIN=false                 # Use built-in MinIO container?

# Local storage path (if STORAGE_TYPE=local)
STORAGE_LOCAL_PATH=./data/media

# S3/MinIO settings (if STORAGE_TYPE=s3, auto-configured if MINIO_BUILTIN=true)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openwa
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# =============================================================================
# DOCKER (container orchestration)
# =============================================================================
# The app talks to the host Docker daemon to start built-in services
# (postgres/redis/minio). Access to the socket effectively grants root on the
# host — only enable where that trust is acceptable.
DOCKER_ENABLED=true                 # Set false to disable Docker integration entirely
# DOCKER_SOCKET_PATH=/var/run/docker.sock   # Override socket location if non-default
# When mounting the socket into a container, mount it READ-ONLY:
#   - /var/run/docker.sock:/var/run/docker.sock:ro   (see docker-compose.yml)

# =============================================================================
# WEBHOOK
# =============================================================================
WEBHOOK_TIMEOUT=10000               # Timeout in milliseconds
WEBHOOK_MAX_RETRIES=3               # Number of retry attempts
WEBHOOK_RETRY_DELAY=5000            # Delay between retries in ms
WEBHOOK_MAX_PER_DISPATCH=100        # Max webhooks fetched per event (bounds fan-out)

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_TTL=60                   # Time window in seconds
RATE_LIMIT_MAX=100                  # Max requests per window

# =============================================================================
# PLUGINS
# =============================================================================
PLUGINS_ENABLED=true                # Enable plugin system
PLUGINS_DIR=./data/plugins          # Plugin directory

# =============================================================================
# SECURITY
# =============================================================================
# Master API key (leave empty to disable, or set to secure value)
API_MASTER_KEY=

# Generated secrets file: the infra config UI writes DB/Redis/S3 credentials to
# ./data/.env.generated with 0600 perms (owner read/write only). For stronger
# isolation, inject these secrets from an external vault (Docker/K8s secrets,
# AWS Secrets Manager, HashiCorp Vault) instead of persisting them to disk.

# =============================================================================
# AUDIT LOG
# =============================================================================
AUDIT_CLEANUP_ENABLED=true          # Periodically delete old audit logs
AUDIT_RETENTION_DAYS=30             # Delete audit logs older than N days
AUDIT_CLEANUP_INTERVAL_HOURS=24     # How often the cleanup runs

# =============================================================================
# DEVELOPER SETTINGS
# =============================================================================
ENABLE_SWAGGER=true                 # Enable API documentation at /api/docs
