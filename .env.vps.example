# OpenWA VPS deployment defaults
#
# Copy to .env on the VPS:
#   cp .env.vps.example .env

NODE_ENV=production
LOG_LEVEL=info

# First run with plain HTTP on the server IP:
OPENWA_SITE_ADDRESS=:80
BASE_URL=http://YOUR_SERVER_IP
DASHBOARD_URL=http://YOUR_SERVER_IP
CORS_ORIGINS=*

# For automatic HTTPS with Caddy, point DNS A record to the VPS and use:
# OPENWA_SITE_ADDRESS=openwa.example.com
# BASE_URL=https://openwa.example.com
# DASHBOARD_URL=https://openwa.example.com
# CORS_ORIGINS=https://openwa.example.com

HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL is the default VPS mode. Data persists in the postgres-data Docker volume.
DATABASE_TYPE=postgres
DATABASE_NAME=openwa
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=change-this-postgres-password
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10

ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--no-first-run,--no-zygote

STORAGE_TYPE=local
REDIS_ENABLED=false
QUEUE_ENABLED=false

# Horizontal scale (Tier 4). Leave off for single-instance deployments.
# When enabled: DATABASE_TYPE must be postgres/mysql (SQLite is rejected),
# Redis backs Socket.io fan-out + the session-ownership registry, and
# PLUGINS_DIR must be shared storage so every node loads identical hooks.
CLUSTER_ENABLED=false
# INSTANCE_ID=          # defaults to the container hostname
# CLUSTER_OWNERSHIP_TTL=30
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

PLUGINS_ENABLED=true
