{
  "name": "openwa",
  "version": "0.27.0",
  "description": "Open Source WhatsApp API Gateway - Free, Self-Hosted HTTP API for WhatsApp",
  "author": "Yudhi Armyndharis & OpenWA Contributors",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "build": "nest build",
    "build:all": "nest build && npm run dashboard:build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prod": "npm run build:all && node dist/main",
    "dev": "concurrently -n api,dashboard -c blue,green \"npm run start:dev\" \"npm run dashboard:dev\"",
    "dashboard:install": "cd dashboard && npm install",
    "dashboard:ci": "cd dashboard && npm ci",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "postinstall": "node scripts/postinstall.js",
    "check:versions": "node scripts/check-doc-versions.mjs",
    "check:dockerignore": "node scripts/check-dockerignore.mjs",
    "check:chart": "node scripts/check-chart-behaviour.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:sdk-routes": "node scripts/check-sdk-routes.mjs",
    "check:sdk-coverage": "node scripts/check-sdk-coverage.mjs",
    "check:sdk-events": "node scripts/check-sdk-events.mjs",
    "check:sdk-docs": "node scripts/check-sdk-docs.mjs",
    "check:contract-shapes": "node scripts/check-contract-shapes.mjs",
    "openapi:export": "ts-node scripts/export-openapi.ts openapi.json",
    "openapi:check": "ts-node scripts/export-openapi.ts /tmp/openapi.generated.json && diff -u openapi.json /tmp/openapi.generated.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:scripts": "node --test scripts/proxy-addr.spec.js scripts/music-metadata.spec.js scripts/postinstall.spec.js scripts/patch-write-failure.spec.js scripts/patch-wwebjs-newsletter-preview.spec.js scripts/patch-wwebjs-status.spec.js scripts/patch-wwebjs-ready-sync.spec.js scripts/patch-wwebjs-participant-arity.spec.js scripts/patch-wwebjs-block.spec.js scripts/patch-wwebjs-group-description.spec.js scripts/patch-wwebjs-media-id.spec.js scripts/patch-wwebjs-send-error.spec.js scripts/patch-wwebjs-puppeteer.spec.js scripts/patch-baileys-appstate.spec.js scripts/patch-baileys-newsletter-create.spec.js scripts/patch-baileys-pairing.spec.js scripts/baileys-pairing.integration.spec.mjs scripts/dockerfile-patchers.spec.js scripts/check-dockerignore.spec.mjs scripts/smoke-test-docker-proxy.spec.js scripts/check-upstream-surface.spec.mjs scripts/check-sdk-docs.spec.mjs scripts/check-audit.spec.mjs scripts/check-contract-shapes.spec.mjs scripts/check-sdk-coverage.spec.mjs scripts/cli-entrypoint-guard.spec.mjs scripts/export-openapi.spec.js",
    "test:docs": "jest src/common/changelog-sections.spec.ts src/common/ci-privilege-gate.spec.ts src/common/docs-ci-jobs.spec.ts src/common/docs-coverage-policy.spec.ts src/common/docs-metrics-list.spec.ts src/common/docs-migration-repair-advice.spec.ts src/common/docs-rollback-deleted-chats.spec.ts src/common/docs-dependabot-excerpt.spec.ts src/common/docs-failed-migration-revert.spec.ts src/common/docs-next-hazard-rows.spec.ts src/common/docs-next-version.spec.ts src/common/docs-roadmap-released-range.spec.ts src/common/docs-sdk-rate-limit.spec.ts src/common/sdk-503-not-sent-docs.spec.ts src/common/sdk-docs-server-contract.spec.ts src/common/openapi/docs-06-contract.spec.ts src/common/openapi/docs-06-chat-id-wording.spec.ts src/common/openapi/docs-06-error-statuses.spec.ts src/common/test-lane-partition.spec.ts src/config/docs-env-example.spec.ts src/config/openapi-contract.spec.ts src/config/openapi-export-pins.spec.ts src/config/wa-web-version-example-pin.spec.ts src/engine/docs-29-counts.spec.ts src/engine/docs-27-backfill-engine.spec.ts src/engine/engine-inventory-parity.spec.ts src/engine/engine-parity.spec.ts src/engine/inventory-mapping-direction.spec.ts src/engine/adapters/baileys-voice-waveform.spec.ts src/engine/adapters/wwebjs-newsletter-preview.spec.ts src/modules/audit/audit-coverage.spec.ts src/modules/auth/global-route-fence-coverage.spec.ts src/modules/auth/query-session-scope-coverage.spec.ts src/modules/docker/compose-network.spec.ts src/modules/queue/bull-board-mount-coverage.spec.ts src/common/release-gate-parity.spec.ts src/database/migrations/__tests__/migration-drift.spec.ts src/common/docs-governance.spec.ts --testPathIgnorePatterns=/node_modules/",
